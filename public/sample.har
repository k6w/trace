            "text": "(function(){const r=document.getElementById('root');const data=window.__BOOT__||{};async function load(){try{const res=await fetch('/api/v2/articles/ten-thousand-paper-lanterns',{headers:{accept:'application/json'}});if(!res.ok)throw new Error(res.statusText);const json=await res.json();render(json)}catch(err){console.error(err);r.innerHTML='<p>Could not load this article.</p>'}}function render(article){const el=document.createElement('div');el.innerHTML=article.html;r.replaceChildren(el);if(window.requestIdleCallback)requestIdleCallback(()=>track(article.id))}function track(id){navigator.sendBeacon('/api/v2/track',JSON.stringify({id,t:Date.now(),visit:data.visit}))}load()})();"
